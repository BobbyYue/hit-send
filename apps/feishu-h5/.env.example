# Server
PORT=8787
HOST=127.0.0.1
HIT_SEND_PUBLIC_ORIGIN=http://127.0.0.1:8787

# Feishu enterprise self-built app
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_BASE_URL=https://open.feishu.cn

# Local development uses the authenticated Codex CLI by default.
HIT_SEND_PROVIDER=codex
HIT_SEND_MODEL=gpt-5.4-mini
HIT_SEND_MODEL_TIMEOUT_MS=45000

# Production alternative: a private model endpoint that accepts the documented
# request body and returns Hit Send JSON.
# HIT_SEND_PROVIDER=endpoint
# HIT_SEND_MODEL_ENDPOINT=https://example.com/api/hit-send
# HIT_SEND_MODEL_TOKEN=xxx
